# ---- Core ----
NODE_ENV=development
DEBUG=1
HTTPS_DOMAIN=0
ROOT_DOMAIN=localhost
DOMAIN_QUERY_PARAM=domain

# ---- Datastores ----
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/btw
TASKS_DATABASE_URL=postgresql://postgres:postgres@localhost:55432/btw
TASKS_REDIS_URL=redis://localhost:6379/

# ---- Service URLs (local defaults) ----
DOMAIN=localhost:9210
PUBLISHER_SERVER_URL=localhost:9222
TASKS_URL=http://localhost:9210
LIST_DOMAIN=localhost:9300
WRITER_DOMAIN=localhost:9000

# ---- CORS / Uploads ----
CORS_DOMAINS=http://localhost:9000,http://localhost:9300,http://localhost:9222
COMPANION_CLIENT_ORIGINS=http://localhost:9000,http://localhost:9300
COMPANION_UPLOAD_URLS=
COMPANION_AWS_ACL=public-read

# ---- Auth / App behavior ----
SECRET=change-me-super-secret
ENCRYPTION_KEY=change-me-encryption-key
TURN_OFF_SINGLE_USER_MODE=0
ADMIN_EMAIL=you@example.com
ADMIN_SLUG=your-slug
ADMIN_OTP=
BTW_UUID_KEY=btw_uuid

# ---- Publisher / Analytics ----
UMAMI_SOURCE=
UMAMI_TOKEN=

# ---- Frontend envs (writer/list) ----
REACT_APP_TASKS_PUBLIC_URL=http://localhost:9210
REACT_APP_UPPY_COMPANION_URL=http://localhost:9210/companion
REACT_APP_YJS_DOMAIN=ws://localhost:9211
REACT_APP_S3_ENDPOINT=
REACT_APP_BTW_UUID_KEY=btw_uuid
REACT_APP_ENCRYPTION_KEY=change-me-encryption-key

# ---- SMTP (optional) ----
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---- S3 (optional) ----
S3_ENDPOINT=
S3_BUCKET=
S3_KEY=
S3_SECRET=

# ---- AI / Messaging integrations (optional) ----
OPENAI_API_KEY=
CLAUDE_API_KEY=
GEMINI_API_KEY=
TELEGRAM_TOKEN=
WHATSAPP_API_TOKEN=
WHATSAPP_NUMBER_ID=

# ---- Render production examples ----
# ROOT_DOMAIN=example.com
# DOMAIN=btw-tasks.onrender.com
# PUBLISHER_SERVER_URL=btw-publisher.onrender.com
# TASKS_URL=https://btw-tasks.onrender.com
